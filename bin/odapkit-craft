#!/bin/sh
# Check a KiCad board against the OpenDAP PCB craft standard, by quality level.
#
# Usage: odapkit craft check [--json] [--config FILE] [--target Qn] [--no-drc] BOARD.kicad_pcb
#
# Runs tools/pcb-craft-check.py with KiCad's bundled Python (pcbnew): the checks DRC cannot do,
# plus the board's own DRC folded in by level (unless --no-drc). Prints the results grouped by
# level (RFC 0010) and the level the board reaches. Configuration: <project>.craft.toml next to
# the board (target level, OSHWA UID, mirrored blocks); see the script's help for the format.
# Standard: kicad-lib docs/specs/pcb-craft-standard.md. KiCad's Python is found through
# $KICAD_PYTHON, then KiCad.app ($KICAD_APP, default /Applications/KiCad/KiCad.app).
#
# Exit status: 0 every item at or below the target passes, 1 otherwise, 2 usage error.
set -eu
self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
here="$(cd "$(dirname "$self")/.." && pwd)"
case "${1:-}" in
  ""|-h|--help|help) sed -n '2,13p' "$self" | sed 's/^# \{0,1\}//'; [ -n "${1:-}" ] && exit 0 || exit 2 ;;
  check) shift ;;
  *) echo "usage: odapkit craft check [--json] [--config FILE] [--target Qn] [--no-drc] BOARD.kicad_pcb" >&2; exit 2 ;;
esac
app="${KICAD_APP:-/Applications/KiCad/KiCad.app}"
py="${KICAD_PYTHON:-$app/Contents/Frameworks/Python.framework/Versions/Current/bin/python3}"
if [ ! -x "$py" ]; then
  py="$(command -v python3 || true)"
  if [ -z "$py" ] || ! "$py" -c 'import pcbnew' 2>/dev/null; then
    echo "odapkit craft: KiCad's Python (pcbnew) not found (set KICAD_PYTHON or KICAD_APP)" >&2
    exit 1
  fi
fi
# KiCad's Python (3.9) has no tomllib: the script reads the configuration through this one.
ODAPKIT_PYTHON3="${ODAPKIT_PYTHON3:-$(command -v python3 || echo python3)}"
export ODAPKIT_PYTHON3 KICAD_APP="$app"
exec "$py" "$here/tools/pcb-craft-check.py" "$@"
